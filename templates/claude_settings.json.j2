{
  "model": "opus",
  "language": "japanese",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "planning-with-files@planning-with-files": true,
    "code-review@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "aws-core@agent-toolkit-for-aws": true,
    "aws-data-analytics@agent-toolkit-for-aws": true,
    "aws-agents@agent-toolkit-for-aws": true,
    "pskoett-ai-skills@pskoett-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    },
    "pskoett-skills": {
      "source": {
        "source": "github",
        "repo": "pskoett/pskoett-skills"
      }
    }
  },
  "cleanupPeriodDays": 9999,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "ENABLE_TOOL_SEARCH": "auto:5 claude"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(pnpm exec prisma *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(nohup python *)",
      "Read(//tmp/**)",
      "mcp__visualize__read_me",
      "mcp__visualize__show_widget",
      "WebSearch",
      "WebFetch(domain:strandsagents.com)",
      "WebFetch(domain:dev.classmethod.jp)",
      "WebFetch(domain:awslabs.github.io)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git clean *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(docker compose down -v *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(docker push *)",
      "Bash(pnpm publish *)",
      "Bash(ansible-playbook *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(cdk deploy *)",
      "Bash(aws *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(/.github/workflows/**)",
      "Bash(chmod 777 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/validate-command.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-secrets.sh\"",
            "statusMessage": "セキュリティチェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lint-on-save.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify-slack.sh\"",
            "async": true
          }
        ]
      }
    ]
  }
}
